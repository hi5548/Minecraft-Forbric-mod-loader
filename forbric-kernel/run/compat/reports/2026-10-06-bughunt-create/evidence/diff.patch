+	/** {@code off} leaves the carrier's client mod-loading flag alone, as the released kernel did. */
+	static final String CLIENT_MOD_LOADING_STATE = "forbric.clientModLoadingState";
+
+	/**
+	 * Publishes each Forge-family client loader's own {@code loading} flag around the kernel's client mod-loading
+	 * window — see {@link #onClientModLoading()}. Only the field is written, never a replacement getter: a mod that
+	 * wants the answer calls {@code ClientModLoader.isLoading()}, so the carrier's getter is what has to answer,
+	 * exactly as in {@link #setForgeLoadingState}.
+	 *
+	 * <p>Both loaders declare it identically on 1.21.1 (javap of neoforge-runtime.jar 21.1.252 and the interop
+	 * carrier: {@code private static boolean loading}, {@code isLoading()Z} reading it). Whichever family's
+	 * {@code begin} the merged base calls is the one present, so an absent sibling is expected, not a fault.
+	 */
+	static void setClientModLoadingState(ClassLoader cl, boolean loading) {
+		if ("off".equalsIgnoreCase(System.getProperty(CLIENT_MOD_LOADING_STATE, "on"))) return;
+		for (Ecosystem ecosystem : new Ecosystem[] {Ecosystem.NEOFORGE, Ecosystem.FORGE}) {
+			String name = ForeignType.CLIENT_MOD_LOADER.binary(ecosystem);
+			try {
+				Class<?> loader = Class.forName(name, false, cl);
+				Field state = loader.getDeclaredField("loading");
+				state.setAccessible(true);
+				state.setBoolean(null, loading);
+			} catch (ClassNotFoundException absent) {
+				// The other family's client loader is not on this instance.
+			} catch (ReflectiveOperationException failed) {
+				ForbricLog.warn("[Forbric/Lifecycle] could not publish the client mod-loading state of " + name, failed);
+			}
+		}
+	}
+
